APP_ENV=development
APP_URL=http://localhost/PROJETS/hotel-residence-sync/public

DB_HOST=localhost
DB_PORT=3306
DB_NAME=hotel_sync
DB_USER=root
DB_PASS=

JWT_SECRET=change_this_secret_key_in_production_min_32_chars
JWT_EXPIRY=86400

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your@email.com
MAIL_PASS=your_password
MAIL_FROM=noreply@sync-hotel.ci
MAIL_FROM_NAME=Hotel-Residence Sync

UPLOAD_MAX_SIZE=5242880

# Web Push (notifications hors application) — générer via scripts/generate-vapid-keys.php
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@example.com
