# Dépendances
/vendor/

# Variables d'environnement (secrets)
.env
.env.local
.env.*.local

# Fichiers uploadés (le contenu est exclu, mais le .htaccess de durcissement
# doit rester versionné pour être déployé)
/public/assets/uploads/*
!/public/assets/uploads/.htaccess
/storage/

# Logs
*.log
/logs/

# Cache & sessions PHP
/cache/
/tmp/

# Fichiers IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
desktop.ini

# Composer lock (optionnel : à conserver si déploiement reproductible)
# composer.lock

# Fichiers de build Node (si ajout d'assets front)
node_modules/
/public/build/

#module de test api
test_agent.py
test_report.html

#database
database.sql
*.sql
# Sauvegarde des templates avant refactor CSS/JS (copie de sécurité locale)
/_backup_templates/

# Binaire Tailwind CLI autonome (40 Mo) — à retélécharger si besoin
/tailwindcss.exe
*.md


# Dossier de staging pour l'hébergement (copie prête à téléverser, contient vendor/)
/copy/

# Documentation Docusaurus (site local uniquement, même convention que documentation/*.md)
/docs-site/